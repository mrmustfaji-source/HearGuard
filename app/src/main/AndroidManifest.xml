<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Poori app mein sirf itni permissions.

      Koi ad nahi, koi analytics nahi, koi tracking nahi. Network sirf ek hi
      jagah use hota hai: Telegram wala remote control, aur wo bhi tabhi jab
      aap use khud chalu karein - neeche dekhiye.
    -->

    <!--
      Samsung se remote control (Telegram) ke liye.

      Pehle ye permission jaan-boojh kar NAHI thi. Ab hai, aur saaf keh dena
      chahiye ki iska matlab kya hai: remote chalu hone par phone ka status
      aur command ka output Telegram ke server se guzarta hai. Remote band ho
      to app koi network call karti hi nahi.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Chetavni dikhane ke liye. Android 13+ par ye maangni padti hai. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Screen session: sirf jab user khud chalu kare, 10 minute, phir band. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Shizuku se baat karne ke liye. Ye Shizuku app khud define karti hai. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Reboot ke baad pehra dobara shuru karne ke liye. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Optional. Isse ye pata chalta hai ki garmi ke waqt screen par kaun si
      app thi - ek ishara, CPU ka naap nahi. User khud Settings mein ja kar
      deta hai; na de to app phir bhi poora kaam karti hai.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Isi ek permission se app culprit ka NAAM bata paati hai.

      Yahan likh dene bhar se ye milti NAHI. Iska protection level is phone
      par `signature|privileged|development` hai - us `development` ki wajah
      se ise ek baar adb se dena padta hai:

          adb shell pm grant com.mustfa.heatguard android.permission.DUMP

      Ek hi baar. Reboot ke baad bhi rehti hai. Bina iske app band nahi hoti,
      bas garmi/drain wale simple mode par chali jaati hai.
    -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Background apps ko rokne ki koshish ke liye. Ye normal permission hai,
         install par hi mil jaati hai. Home/launcher jaise apps par kaam nahi
         karti - unke liye notification Settings tak le jaati hai. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Kis app ka page kholna hai, ye poochhne ke liye. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>

        <!--
          Android 11+ apps ko ek doosre se "andha" rakhta hai jab tak yahan
          saaf na likha jaye. Iske bina `setPackage("org.telegram...")` wali
          intent (RemoteActivity.shareToTelegram) aur `tg://` wali deep link
          (BotFather seedha kholna) chalte hi nahi - koi error bhi nahi aata,
          bas chup-chaap "Telegram nahi mila" wale fallback par chala jaata.
        -->
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.telegram.plus" />
        <package android:name="nekox.messenger" />
        <package android:name="org.thunderdog.challegram" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeatGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="heatguard.app" android:pathPrefix="/p/" />
                <data android:scheme="heatguard" android:host="p" />
            </intent-filter>
        </activity>

        <!--
          Shizuku ka provider. Iske bina Shizuku hamari app ko pehchanta hi
          nahi. authorities mein ".shizuku" lagana zaroori hai - do apps ek
          hi authority nahi rakh sakti.
        -->
        <provider
            android:name=".ApkShareProvider"
            android:authorities="${applicationId}.apkshare"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".LinkActivity"
            android:exported="false"
            android:label="@string/link_title" />

        <activity
            android:name=".PadActivity"
            android:exported="false"
            android:label="Controls" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".ScreenActivity"
            android:exported="false"
            android:label="@string/screen_title" />

        <!--
          Screen dekhna/chalana ab isi se hota hai, Shizuku se nahi - ek
          baar Settings > Accessibility mein ON karna hai, uske baad koi
          popup ya dobara setup nahi. exported="true" zaroori hai (system
          isi tarah bind karta hai); permission is per-app sabhi
          Accessibility services par lagti hai, koi doosri app ise chala
          nahi sakti.
        -->
        <service
            android:name=".HgAccessibility"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".ListenService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ScreenService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:label="@string/remote_title" />

        <activity
            android:name=".GuardActivity"
            android:exported="false" />

        <activity
            android:name=".DeepSleepActivity"
            android:exported="false"
            android:label="@string/deep_title" />

        <!--
          Har ~15 minute par chalne wala check, aur notification ka "1 ghante
          chup" button. exported=false: ise sirf ye app hi trigger karti hai.
        -->
        <receiver
            android:name=".CheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mustfa.heatguard.CHECK" />
                <action android:name="com.mustfa.heatguard.SNOOZE" />
                <action android:name="com.mustfa.heatguard.STOP_APP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
