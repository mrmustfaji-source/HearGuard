<?xml version="1.0" encoding="utf-8"?>
<!--
  HgAccessibility ki settings.

  canTakeScreenshot aur canPerformGestures - yehi do capabilities hain jo
  screen dekhne/chalane ke liye chahiye. canRetrieveWindowContent
  jaan-boojh kar NAHI hai - hume screen ka TEXT/content padhna hi nahi,
  sirf tasveer aur tap/swipe/back/home/recents chahiye.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="100"
    android:description="@string/accessibility_description" />
